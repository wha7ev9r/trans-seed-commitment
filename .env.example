# ============================================================
# trans-commitment 环境变量样例
# 用法：复制为 .env 并修改，docker compose up 时自动加载
# ============================================================

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- Transmission Web UI 认证（RPC + Flood iframe 都用这个）----
# 强烈建议使用 ≥20 位随机字符串，可用：openssl rand -base64 24
TRANSMISSION_USER=admin
TRANSMISSION_PASS=change-me-to-a-strong-password-20chars
# Transmission 仅支持 * 通配符，不支持 CIDR；默认允许 Docker 私网来源。
TRANSMISSION_RPC_WHITELIST=127.0.0.1,::1,10.*.*.*,172.*.*.*,192.168.*.*

# ---- quota-guard 控制台 Basic Auth（独立一层认证）----
QUOTA_USER=seed
QUOTA_PASS=change-me-another-strong-password

# ---- 端口 ----
# quota-guard 控制台 + Flood UI 整合入口（OpenResty 反代这个端口）
QUOTA_GUARD_PORT=9092
# P2P peer 端口固定为 51413（必须公网开放 tcp+udp）
# 如需改端口，请同步修改 docker-compose.yml 与 transmission/settings.json

# ---- 月度上传配额（字节）
# 默认 1 TiB = 1099511627776
# 常用值：
#   500  GB = 536870912000
#   1    TB = 1099511627776
#   2    TB = 2199023255552
#   5    TB = 5497558138880
MONTHLY_QUOTA_BYTES=1099511627776

# ---- 配额检测与安全余量 ----
# 每 10 秒检查一次；在配额前预留 1 GiB，降低轮询期间超额的风险。
CHECK_INTERVAL_SECONDS=60
QUOTA_SAFETY_MARGIN_BYTES=1073741824

# ---- PUID / PGID（linuxserver 镜像权限）----
# 默认 1000:1000，按宿主机实际用户改
PUID=1000
PGID=1000

# ---- 监控的网卡名（vnstat 用，常见 eth0 / ens3 / enp3s0）----
# 用 `ip link` 或 `ip a` 查看 VPS 主网卡
VNSTAT_INTERFACE=eth0
